{
  "name": "projects-map",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && node scripts/check-browser.mjs",
    "validate": "node scripts/validate.mjs && node scripts/validate-links.mjs && node scripts/validate-knowledge.mjs",
    "check": "npm test && npm run build && npm run validate",
    "check:all": "npm run check && node scripts/check-browser.mjs"
  },
  "dependencies": {
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
